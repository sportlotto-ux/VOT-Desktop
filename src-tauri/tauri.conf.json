{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VotDesktop",
  "version": "0.2.5",
  "identifier": "ru.votdesktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VotDesktop",
        "width": 800,
        "height": 600,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "Download YouTube with Yandex VOT translation",
    "longDescription": "Desktop app for downloading YouTube videos with automatic Yandex voice translation (VOT) and audio mixing.",
    "linux": {
      "deb": {
        "depends": ["ffmpeg"]
      }
    }
  }
}
